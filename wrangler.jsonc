{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookie-paradise-travel",
  "main": "vinext/server/fetch-handler",
  "workers_dev": false,
  "routes": [
    { "pattern": "cookieparadisetravel.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookie-paradise-travel-db",
      "database_id": "d2d57029-217d-4476-a262-946eb21c060d",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SQUARE_ENV": "sandbox",
    "SQUARE_APPLICATION_ID": "sandbox-sq0idb-LXRKY7_IJOLJU8Ec0rk_SQ",
    "SQUARE_LOCATION_ID": "LF9EW4W95QPA7",
    "SQUARE_WEBHOOK_NOTIFICATION_URL": "https://cookieparadisetravel.com/api/square/webhook",
    "MAILERSEND_FROM_EMAIL": "trung@cookieparadisetravel.com",
    "MAILERSEND_FROM_NAME": "Cookie Paradise Travel Company"
  }
}
